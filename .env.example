# ─────────────────────────────────────────────────────────────────
# BETTER CLINIC — environment variables
# Copy this file to .env.local and fill in your values.
# Everything below is OPTIONAL for cloning — the app shows a friendly
# "Connect Supabase" setup screen until the required values are set.
# ─────────────────────────────────────────────────────────────────

# ── REQUIRED: Supabase project ───────────────────────────────────
# Supabase Dashboard → Your project → Project Settings → API
# 1. Project URL        → NEXT_PUBLIC_SUPABASE_URL
# 2. anon public key    → NEXT_PUBLIC_SUPABASE_ANON_KEY
# 3. service_role key   → SUPABASE_SERVICE_ROLE_KEY  (server-only: seeding + staff admin actions)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── REQUIRED for local scripts only (migrations, seed, RLS tests) ─
# Supabase Dashboard → Project Settings → Database → Connection string → URI
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=

# ── Environment mode (the APP_ENV toggle) ────────────────────────
# "demo"       → synthetic data, demo quick-login, simulated emergency/queue progression
# "production" → real data only, all simulation controls removed
NEXT_PUBLIC_APP_ENV=demo

# ── OPTIONAL: AI assistant LLM provider ──────────────────────────
# Any OpenAI-compatible chat-completions endpoint. Leave AI_API_KEY empty
# to use the built-in deterministic, database-grounded fallback —
# the assistant fully works without an LLM key.
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# ── OPTIONAL: maps / geocoding (not required for core features) ──
MAPS_API_KEY=

# Public app URL used in auth redirect emails. Falls back to the
# request origin when empty (fine for local development).
NEXT_PUBLIC_APP_URL=
